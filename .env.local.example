# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=sua-chave-secreta-aqui-gere-com-openssl-rand-base64-32

# Google OAuth (only needed for AUTH_MODE=public or whitelist)
GOOGLE_CLIENT_ID=seu-google-client-id-aqui
GOOGLE_CLIENT_SECRET=seu-google-client-secret-aqui

# Authentication Mode
# Options: disabled | credentials | whitelist | public
# - disabled: No authentication required (local/personal use)
# - credentials: Email/password login with local user registration
# - whitelist: Google OAuth restricted to specific emails
# - public: Any Google account can access (public with isolated data)
AUTH_MODE=credentials

# Registration Control (only used when AUTH_MODE=credentials)
# Set to false to block new registrations
ALLOW_REGISTRATION=true

# Whitelist (only used when AUTH_MODE=whitelist)
# Comma-separated list of allowed emails
ALLOWED_EMAILS=seu-email@gmail.com,outro-email@gmail.com
